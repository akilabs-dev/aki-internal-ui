# ── Auto-open Card / Navbar / … in Figma when you click the button ──
# 1. Figma → Settings → Security → Personal access tokens → Generate
# 2. Open your Team project file in the browser → copy FILE_KEY from the URL:
#    https://www.figma.com/design/FILE_KEY/...
# 3. Copy this file to .env and fill in the two values below
# 4. Restart: npm run dev

VITE_FIGMA_ACCESS_TOKEN=
VITE_FIGMA_FILE_KEY=

# Optional: full design file URL instead of FILE_KEY
# VITE_FIGMA_FILE_URL=https://www.figma.com/design/YOUR_FILE_KEY/Your-File-Name
